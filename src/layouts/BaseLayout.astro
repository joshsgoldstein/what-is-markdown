---
import '../styles/publication.css';
interface Props {
  title: string;
  description?: string;
  image?: string;
}
const {
  title,
  description = 'Field notes for the AI age. From Lost In AI Land.',
  image = '/images/og-default.png',
} = Astro.props;
const siteUrl = 'https://joshsgoldstein.github.io/what-is-markdown';
const ogImage = image.startsWith('http') ? image : `${siteUrl}${image}`;
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/?$/, '/');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:type" content="website" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body>

  <a class="skip-link" href="#main-content">Skip to content</a>
  <header class="publication-header">
    <div class="publication-utility"><a href={base}>Independent thinking. Practical understanding.</a><a href="https://lostinai.substack.com/">Subscribe on Substack ↗</a></div>
    <a class="publication-masthead" href={base} aria-label="Lost In AI Land home">LOST IN AI LAND<span aria-hidden="true">✳</span></a>
    <div class="publication-nav"><nav aria-label="Main navigation"><a href={`${base}articles`}>Articles</a><a href={`${base}cheatsheets`}>Cheatsheets</a><a href={`${base}tags`}>Explore topics</a></nav><span>Field notes for the AI age.</span></div>
  </header>

  <main id="main-content">
  <slot />
  </main>
  <footer class="publication-footer"><div><a href={base}>Lost In AI Land ✳</a><p>Making sense of the tools changing how we work.</p></div><div><a href={`${base}articles`}>Read the articles ↗</a><a href="https://lostinai.substack.com/">Follow on Substack ↗</a><span>Written by Josh Goldstein</span></div></footer>

</body>
</html>
