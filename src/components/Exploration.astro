---
import { getCollection } from 'astro:content';
const { direction } = Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/?$/, '/');
const options=[['magazine','01 Magazine'],['notebook','02 Notebook'],['stories','03 Stories'],['cabinet','04 Cabinet'],['pocket','05 Pocket guide'],['atlas','06 Atlas']];
const articles=(await getCollection('articles')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const topic=(a:any)=>a.data.tags.find((t:string)=>!['basics','ai'].includes(t.toLowerCase()))??'AI';
const href=(a:any)=>`${base}articles/${a.slug}/`;
const image=(a:any)=>`${base}${a.data.image.replace(/^\//,'')}`;
const labels:Record<string,string>={Docker:'The shipping port',CLI:'Command station',git:'The save point',markdown:'The writing room'};
const decks:Record<string,string>={Docker:'A portable home for code. A surprisingly big part of the AI story.',CLI:'Why a blinking cursor still has so much to say.',git:'A safety net for your work, one commit at a time.',markdown:'A shared language for humans, documents, and AI.'};
const [lead,...rest]=articles;
const resources=[['Docker','docker-cheatsheet','docker run hello-world'],['Git','git-cheatsheet','git status'],['Markdown','markdown-cheatsheet','# Hello, world']];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>{options.find(o=>o[0]===direction)?.[1]} — Lost In AI Land</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet"/></head>
<body class={direction}><a class="skip" href="#main">Skip to content</a>
<aside class="switcher" aria-label="Design previews"><a href={`${base}concepts/`}>Compare all six</a><nav aria-label="Choose a design">{options.map(([id,name])=><a href={`${base}concepts/${id}/`} aria-current={id===direction?'page':undefined}>{name}</a>)}</nav></aside>
<div class="page"><header><a class="brand" href={`${base}concepts/${direction}/`}>Lost In AI Land<span class="brand-dot" aria-hidden="true">.</span></a><nav aria-label="Publication"><a href={`${base}articles/`}>Articles</a><a href={`${base}cheatsheets/`}>Cheatsheets</a><a href={`${base}rss.xml`}>RSS ↗</a></nav></header>
<main id="main">
{direction==='cabinet'&&<>
<section class="cabinet-intro"><div><p class="label">A COLLECTION OF USEFUL DISCOVERIES</p><h1>A little less lost.<br/>A lot more curious.</h1></div><p class="intro-note">Notes, stories, and the occasional dinosaur.<br/>Making sense of AI, one discovery at a time.</p></section>
<section class="desk" aria-label="The curiosity cabinet">
<a class="clipping feature" href={href(lead)}><div class="clipping-top"><span class="label">THE LATEST FIND / {topic(lead)}</span><span>↗</span></div><img src={image(lead)} alt="Dinosaur and AI companion exploring Docker containers" fetchpriority="high"/><div class="clip-copy"><h2>{lead.data.title}</h2><p>{decks[topic(lead)]}</p><span class="text-link">Open the story ↗</span></div></a>
<div class="desk-side"><aside class="sticky"><p class="label">NOTE TO SELF</p><p>You don’t have to know everything.<br/><mark>Just keep asking.</mark></p><span class="scribble" aria-hidden="true">↳ start somewhere</span></aside><a class="specimen" href={href(articles.find(a=>topic(a)==='markdown')??rest[0])}><img src={image(articles.find(a=>topic(a)==='markdown')??rest[0])} alt="Illustrated Markdown field discovery"/><span class="label">FOUND IN THE WRITING ROOM ↗</span></a></div>
<div class="index-slip"><p class="label">CABINET INDEX / {String(articles.length).padStart(2,'0')} FINDS</p>{articles.map((a,i)=><a href={href(a)}><span>0{i+1}</span><strong>{topic(a)}</strong><span>↗</span></a>)}<p>Small explanations.<br/>Useful things to keep.</p></div>
</section><section class="more-finds"><div class="section-title"><h2>More things worth opening.</h2><a href={`${base}articles/`}>The complete collection ↗</a></div><div class="find-grid">{rest.map((a,i)=><a href={href(a)}><span class="label">FIND 0{i+2} / {topic(a)}</span><img src={image(a)} alt={`${topic(a)} article cover`} loading="lazy"/><h3>{a.data.title}</h3><span class="text-link">Take a look ↗</span></a>)}</div></section>
</>}
{direction==='pocket'&&<>
<section class="pocket-intro"><p class="label">YOUR POCKET GUIDE TO THE AI AGE</p><h1>Big ideas.<br/>Tiny arms.<br/>Let’s explore.</h1><p>Friendly explanations of AI and the tools around it.<br/>No experience required. Curiosity recommended.</p></section>
<section class="console" aria-label="Featured expedition"><div class="console-top"><span>LOST IN AI LAND / FIELD GUIDE</span><span class="power">● READY TO READ</span></div><div class="console-display"><img src={image(lead)} alt="A dinosaur expedition to the Docker shipping port" fetchpriority="high"/><span class="display-tag">DESTINATION 01 / DOCKER</span></div><div class="console-controls"><div><p class="label">CURRENT EXPEDITION</p><h2>{lead.data.title}</h2><p>{decks[topic(lead)]}</p></div><a class="go" href={href(lead)}>Let’s go <span>↗</span></a></div></section>
<section class="cartridges"><div class="section-title"><h2>Choose your next discovery.</h2><span class="label">{articles.length} GUIDES / ALWAYS CURIOUS</span></div><div class="cartridge-grid">{rest.map((a,i)=><a class="cartridge" href={href(a)}><div class="cartridge-label"><span>0{i+2}</span><strong>{topic(a)}</strong><span>↗</span></div><img src={image(a)} alt={`${topic(a)} guide cover`} loading="lazy"/><h3>{a.data.title}</h3><p>{decks[topic(a)]}</p><span class="text-link">Open guide →</span></a>)}</div></section>
</>}
{direction==='atlas'&&<>
<section class="atlas-intro"><p class="label">AN ATLAS FOR THE AI AGE</p><h1>There’s a whole<br/>world to figure out.</h1><p>Pick a place. Follow your curiosity.<br/>We’ll make sense of the tools along the way.</p></section>
<section class="map" aria-label="Explore four article destinations"><svg class="terrain" viewBox="0 0 1200 650" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><defs><pattern id="water" width="28" height="28" patternUnits="userSpaceOnUse"><path d="M4 18q5-4 10 0" fill="none" stroke="#669c93" stroke-width=".8" opacity=".35"/></pattern></defs><rect width="1200" height="650" fill="#b9d9cf"/><rect width="1200" height="650" fill="url(#water)"/><path d="M-30 98Q80 10 202 65T455 72Q550 55 633 166T828 220Q965 200 1015 288T1233 412L1250 660H-40Z" fill="#ecebd3" stroke="#728c6b" stroke-width="3"/><g fill="none" stroke="#bfcaab" stroke-width="2"><path d="M-10 155Q130 55 300 138T580 214T826 292T1210 470"/><path d="M-10 193Q130 93 300 176T580 252T826 330T1210 508"/><path d="M-10 231Q130 131 300 214T580 290T826 368T1210 546"/></g><path d="M175 400Q310 170 490 335T810 415T1040 210" fill="none" stroke="#718d72" stroke-width="3" stroke-dasharray="6 9"/><g fill="#789379"><path d="m410 140 18-30 18 30zm25 8 22-42 22 42zm395 400 22-42 22 42zm30 0 22-42 22 42zm-735-50 22-42 22 42z"/></g></svg>
<div class="map-caption label">LOST IN AI LAND<br/>A MAP OF USEFUL THINGS</div><div class="compass" aria-hidden="true">N<br/>↑</div>
{articles.map((a,i)=><a class={`map-stop stop-${i}`} href={href(a)}><span class="map-pin">0{i+1}</span><div><img src={image(a)} alt=""/><span class="label">{topic(a)}</span><strong>{labels[topic(a)]}</strong><span class="visit">Explore story ↗</span></div></a>)}<span class="map-scale label" aria-hidden="true">0 ━━━━━ 1 NEW IDEA</span></section>
<section class="atlas-index"><div class="section-title"><h2>A few good places to start.</h2><span class="label">THE EXPLORER’S INDEX</span></div>{articles.map((a,i)=><a href={href(a)}><span class="index-num">0{i+1}</span><div><span class="label">{topic(a)} / {labels[topic(a)]}</span><h3>{a.data.title}</h3><p>{decks[topic(a)]}</p></div><span class="index-arrow" aria-hidden="true">↗</span></a>)}</section>
</>}
<section class="tools"><div><p class="label">GOOD THINGS TO KEEP CLOSE</p><h2>A few tools for the journey.</h2></div><div class="tool-links">{resources.map(([name,path,code])=><a href={`${base}${path}/`}><strong>{name} cheatsheet <span>↗</span></strong><code>{code}</code></a>)}</div></section>
</main><footer><a class="brand" href={base}>Lost In AI Land.</a><p>Independent thinking. Practical understanding.</p><a href={`${base}rss.xml`}>Follow along via RSS ↗</a></footer></div></body></html>
<style is:global>
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;color:var(--ink);background:var(--canvas);font-family:'DM Sans',Arial,sans-serif;-webkit-font-smoothing:antialiased}a{color:inherit;text-decoration:none}a:focus-visible{outline:3px solid #0064e2;outline-offset:5px}a:hover .text-link,a:hover h3{text-decoration:underline;text-underline-offset:5px}img{display:block;width:100%;height:auto}h1,h2,h3,p{margin:0}h1,h2,h3{text-wrap:balance}h1{font-size:clamp(44px,6vw,82px);font-weight:500;letter-spacing:-.065em;line-height:1.02}.label{font:11px/1.6 'IBM Plex Mono',monospace;letter-spacing:.035em;text-transform:uppercase}.skip{position:absolute;top:-100px;background:#111;color:#fff;padding:15px;z-index:20}.skip:focus{top:0}.switcher{background:#172025;color:#fff;display:flex;align-items:center;justify-content:space-between;gap:18px;padding:10px 24px;font-size:11px}.switcher nav{display:flex;gap:5px;flex-wrap:wrap}.switcher nav a{padding:8px 11px;border:1px solid #647077;border-radius:3px}.switcher [aria-current]{background:white;color:#172025}.page{max-width:1440px;margin:auto;padding:0 48px}header{display:flex;align-items:center;justify-content:space-between;padding:30px 0;gap:20px}.brand{font-size:27px;font-weight:700;letter-spacing:-.06em}.brand-dot{color:inherit}header nav{display:flex;gap:28px;font-size:13px}.section-title{display:flex;align-items:baseline;justify-content:space-between;gap:20px;margin:55px 0 25px}.section-title h2{font-size:32px;letter-spacing:-.045em}.section-title>a{font-size:13px}.text-link{font-size:13px;font-weight:600}.tools{margin:65px 0 50px;padding-top:30px;border-top:1px solid currentColor;display:grid;grid-template-columns:1fr 1.8fr;gap:35px}.tools h2{font-size:27px;letter-spacing:-.04em;margin-top:10px}.tool-links{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.tool-links a{display:block;padding:12px 0}.tool-links strong{font-size:14px;display:flex;justify-content:space-between;gap:12px}.tool-links code{font:11px/1.6 'IBM Plex Mono',monospace;display:block;margin-top:15px;overflow-wrap:anywhere}footer{display:flex;justify-content:space-between;align-items:center;gap:20px;border-top:1px solid currentColor;padding:30px 0 45px;font-size:12px}footer .brand{font-size:21px}footer p{opacity:.7}
/* School-inspired collected desk: light typography, real clippings, gray surfaces. */
.cabinet{--canvas:#f2f2f2;--ink:#303030}.cabinet-intro{display:flex;align-items:end;justify-content:space-between;gap:25px;margin:30px 0 45px}.cabinet-intro .label{margin-bottom:18px}.intro-note{font-size:14px;line-height:1.6;max-width:300px;padding-bottom:4px}.desk{display:grid;grid-template-columns:1.7fr 1fr .65fr;gap:20px;align-items:start}.clipping,.sticky,.specimen,.index-slip,.find-grid>a{border-radius:10px;box-shadow:0 3px 6px #00000013;overflow:hidden}.feature{background:#fff;transform:rotate(-1deg)}.clipping-top{display:flex;justify-content:space-between;padding:14px 17px}.clipping-top>span:last-child{color:#0064e2}.feature>img{aspect-ratio:1.5;object-fit:cover}.clip-copy{padding:22px}.clip-copy h2{font-size:32px;font-weight:500;letter-spacing:-.045em;line-height:1.12}.clip-copy p{font-size:14px;line-height:1.6;margin:12px 0 22px}.desk-side{display:grid;gap:22px}.sticky{background:#dbdbdb;padding:22px;transform:rotate(2deg);margin-top:8px}.sticky>p:nth-child(2){font-size:26px;letter-spacing:-.04em;line-height:1.35;margin:20px 0}.sticky mark{background:#f9f5a2;color:inherit}.scribble{font:italic 17px Georgia,serif;display:block;text-align:right}.specimen{background:#dbdbdb;padding:10px;transform:rotate(-2deg)}.specimen img{aspect-ratio:1.35;object-fit:cover;border-radius:4px}.specimen .label{display:block;font-size:9px;margin:13px 2px 5px}.index-slip{background:#dbdbdb;padding:20px 16px;margin-top:30px}.index-slip>a{display:flex;align-items:center;gap:10px;border-top:1px solid #a9a9a9;padding:20px 0;font-size:13px}.index-slip>a:first-of-type{margin-top:20px}.index-slip>a>span{font:10px 'IBM Plex Mono',monospace}.index-slip>a>span:last-child{margin-left:auto}.index-slip>p:last-child{font:11px/1.6 'IBM Plex Mono',monospace;margin-top:15px}.find-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.find-grid>a{padding:16px;background:#e1e1e1}.find-grid .label{display:block;margin-bottom:15px}.find-grid img{aspect-ratio:1.7;object-fit:cover;border-radius:4px}.find-grid h3{font-size:23px;font-weight:500;line-height:1.2;letter-spacing:-.04em;margin:18px 0}.cabinet .text-link{color:#0064e2}
/* Playdate-inspired pocket guide: yellow shell, violet actions, physical media. */
.pocket{--canvas:#ffc500;--ink:#312f27}.pocket-intro{position:relative;margin:40px 0 35px}.pocket-intro h1{font-size:clamp(58px,7.7vw,106px);font-weight:700;margin-top:22px;max-width:700px}.pocket-intro>p:last-child{position:absolute;bottom:8px;right:0;font-size:17px;line-height:1.6;max-width:335px}.console{background:#312f27;color:#fff;border-radius:22px;padding:18px 22px 28px;box-shadow:0 8px 0 #b78c00}.console-top{font:10px 'IBM Plex Mono',monospace;display:flex;justify-content:space-between;padding:4px 2px 18px;gap:20px}.power{color:#ffc500}.console-display{position:relative;overflow:hidden;border-radius:5px;background:#101818}.console-display img{aspect-ratio:2.65;object-fit:cover;object-position:50% 26%}.display-tag{position:absolute;bottom:15px;left:15px;background:#ffc500;color:#312f27;font:10px 'IBM Plex Mono',monospace;padding:10px 14px}.console-controls{display:flex;align-items:center;justify-content:space-between;gap:35px;padding:25px 5px 0}.console-controls h2{font-size:clamp(26px,3vw,42px);letter-spacing:-.045em;max-width:700px;margin:8px 0 12px}.console-controls p:last-child{font-size:14px;color:#dedbd1}.go{display:flex;align-items:center;justify-content:space-between;gap:35px;background:#7700ff;padding:22px 26px;border-radius:40px;font-size:19px;white-space:nowrap}.cartridge-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:25px}.cartridge{background:#fff;border:2px solid #312f27;border-radius:12px;padding:18px;box-shadow:0 5px 0 #312f27;display:flex;flex-direction:column}.cartridge-label{display:flex;justify-content:space-between;font:12px 'IBM Plex Mono',monospace;align-items:center;border-bottom:2px solid;padding:2px 0 14px;margin-bottom:15px}.cartridge-label strong{text-transform:uppercase;letter-spacing:.08em}.cartridge img{aspect-ratio:1.6;object-fit:cover;border-radius:4px}.cartridge h3{font-size:24px;line-height:1.12;letter-spacing:-.045em;margin:20px 0 12px}.cartridge p{font-size:14px;line-height:1.5;margin-bottom:25px}.cartridge .text-link{margin-top:auto}.pocket .tools{margin-top:75px}
/* Spatial atlas: vector cartography and real article landmarks, ordinary index below. */
.atlas{--canvas:#f7f8ee;--ink:#24483f}.atlas header{border-bottom:1px solid #b6c8b7}.atlas-intro{text-align:center;padding:45px 0 35px}.atlas-intro h1{font-size:clamp(44px,5.5vw,74px);margin:20px 0}.atlas-intro>p:last-child{font-size:16px;line-height:1.6}.map{position:relative;height:650px;border:1px solid #8fae9a;overflow:hidden;border-radius:50% 50% 8px 8px / 12% 12% 8px 8px}.terrain{position:absolute;inset:0;width:100%;height:100%}.map-caption{position:absolute;top:75px;left:35px;font-size:9px;line-height:1.8}.compass{position:absolute;right:45px;top:50px;font:18px/1.4 Georgia,serif;text-align:center}.map-stop{position:absolute;display:flex;align-items:center;gap:10px;transition:transform .2s}.map-stop:hover{transform:translateY(-5px)}.map-pin{border:2px solid #24483f;border-radius:50%;width:32px;height:32px;display:grid;place-items:center;background:#f7f8ee;font:11px 'IBM Plex Mono',monospace;flex-shrink:0}.map-stop>div{padding:8px;background:#f7f8ee;border:1px solid #6e8d74;box-shadow:3px 4px 0 #24483f26;width:190px}.map-stop img{height:90px;object-fit:cover}.map-stop .label{font-size:9px;display:block;margin:8px 4px 3px}.map-stop strong{font-size:17px;display:block;letter-spacing:-.035em;margin:0 4px 8px}.visit{font:10px 'IBM Plex Mono',monospace;margin:0 4px 5px;display:block}.stop-0{left:8%;top:42%;transform:rotate(-3deg)}.stop-1{left:33%;top:17%;transform:rotate(2deg)}.stop-2{right:24%;top:56%;transform:rotate(-2deg)}.stop-3{right:4%;top:26%;transform:rotate(3deg)}.map-scale{position:absolute;bottom:22px;left:30px;font-size:9px}.atlas-index{max-width:1000px;margin:auto}.atlas-index>a{border-top:1px solid #b6c8b7;padding:25px 0;display:flex;align-items:baseline;gap:30px}.index-num{font:14px 'IBM Plex Mono',monospace}.atlas-index h3{font-size:27px;line-height:1.15;letter-spacing:-.035em;margin:7px 0 10px}.atlas-index p{font-size:14px;line-height:1.6}.index-arrow{margin-left:auto;font-size:28px}.atlas .tools{border-color:#b6c8b7}
@media(min-width:1500px){.pocket .page{max-width:1280px}}
@media(max-width:1000px){.page{padding:0 28px}.switcher{display:block}.switcher>a{display:none}.switcher nav{justify-content:center}.desk{grid-template-columns:1.5fr 1fr}.index-slip{grid-column:1/-1;margin:0;display:flex;align-items:center;justify-content:space-between;gap:20px}.index-slip>a{border:0;padding:10px 0}.index-slip>a:first-of-type{margin:0}.index-slip>p:last-child{display:none}.cabinet-intro{align-items:start}.intro-note{max-width:220px}.pocket-intro>p:last-child{position:static;margin-top:25px;max-width:none}.tools{grid-template-columns:1fr}.map-stop>div{width:155px}.map-stop img{height:75px}.stop-0{left:3%}.stop-1{left:27%}.stop-2{right:24%;top:61%}.stop-3{right:3%}.map{height:610px}footer p{display:none}}
@media(max-width:650px){.page{padding:0 20px}.switcher{padding:10px}.switcher nav{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:5px}.switcher nav a{font-size:10px;text-align:center;padding:9px 5px}header{padding:25px 0;flex-wrap:wrap}.brand{font-size:27px}header nav{gap:25px;width:100%;font-size:12px}.cabinet-intro{display:block;margin:20px 0 30px}.cabinet-intro h1{font-size:45px}.intro-note{max-width:none;margin-top:20px}.desk{display:block}.feature{display:block;transform:rotate(-.7deg)}.clip-copy h2{font-size:29px}.desk-side{grid-template-columns:1fr 1fr;gap:12px;margin:20px 0}.sticky{padding:15px;margin:0}.sticky .label{font-size:9px}.sticky>p:nth-child(2){font-size:20px;margin:16px 0}.scribble{font-size:14px}.specimen{padding:7px;align-self:center}.specimen .label{font-size:8px}.index-slip{display:block;padding:18px}.index-slip>a{border-top:1px solid #aaa;padding:16px 0}.index-slip>a:first-of-type{margin-top:14px}.find-grid,.cartridge-grid{grid-template-columns:1fr;gap:22px}.find-grid h3{font-size:27px}.section-title{display:block;margin-top:40px}.section-title h2{font-size:29px;margin-bottom:12px}.section-title>.label{font-size:10px}.pocket-intro{margin:20px 0 30px}.pocket-intro h1{font-size:64px}.pocket-intro>p:last-child{font-size:15px}.console{padding:14px 12px 20px;border-radius:16px}.console-top{font-size:8px;gap:10px;line-height:1.6}.console-display img{aspect-ratio:1.2;object-position:50% 22%}.display-tag{font-size:8px;bottom:10px;left:10px;padding:8px}.console-controls{display:block;padding:22px 5px 0}.console-controls h2{font-size:30px}.console-controls p:last-child{line-height:1.6}.go{margin-top:24px;padding:17px 24px;font-size:17px}.cartridge h3{font-size:28px}.atlas-intro{padding:20px 0 30px}.atlas-intro h1{font-size:45px}.map{height:850px;border-radius:40px 40px 8px 8px}.map-caption{top:25px;left:20px}.compass{top:20px;right:20px}.map-stop>div{width:185px}.map-stop img{height:85px}.map-stop strong{font-size:17px}.stop-0{left:7%;top:12%}.stop-1{left:auto;right:6%;top:34%}.stop-2{left:5%;right:auto;top:56%}.stop-3{right:4%;top:78%}.stop-3 img{display:none}.map-scale{bottom:15px;left:20px}.atlas-index>a{gap:15px}.atlas-index h3{font-size:24px}.atlas-index p{font-size:13px}.index-arrow{font-size:20px}.atlas-index .label{font-size:9px}.tools{margin:45px 0 30px;gap:20px}.tool-links{grid-template-columns:1fr;gap:0}.tool-links a{border-bottom:1px solid #0002;padding:18px 0}.tool-links code{margin-top:10px}footer{align-items:start;font-size:11px}footer .brand{font-size:19px;max-width:150px}footer>a:last-child{max-width:110px;text-align:right;line-height:1.5}}
