---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const articles = (await getCollection('articles')).sort((a,b) => b.data.date.valueOf()-a.data.date.valueOf());
const [featured, ...rest] = articles;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const date = (d: Date) => d.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric',timeZone:'UTC'});
const minutes = (body: string) => Math.max(1,Math.ceil(body.split(/\s+/).length/220));
const resources = [{name:'Markdown',symbol:'.md',detail:'Give your words a little structure.',path:'markdown-cheatsheet'},{name:'Git',symbol:'git',detail:'Save your progress. Understand your history.',path:'git-cheatsheet'},{name:'Docker',symbol:'>_',detail:'Get to know the container underneath.',path:'docker-cheatsheet'}];
---
<BaseLayout title="Lost In AI Land — Field Notes for the AI Age">
  <div class="publication-home">
    <section class="editorial-intro"><h1>A little less lost.<br />A lot more curious.</h1><p>Plain-language stories about AI and the tools around it.<br class="desktop-break" /> What they do, where they came from, and why they matter.</p></section>
    {featured && <section class="lead-story" aria-label="Latest story">
      <a class="lead-image" href={`${base}articles/${featured.slug}`}><img src={`${base}${(featured.data.image ?? '/images/og-default.png').replace(/^\//, '')}`} alt={`Illustration for ${featured.data.title}`} fetchpriority="high" /><span class="image-caption">UNDER THE HOOD / {featured.data.tags.find(t => !['basics', 'ai'].includes(t.toLowerCase())) ?? 'AI'}</span></a>
      <div class="lead-copy"><div class="eyebrow"><span class="blue-dot"></span>The latest / {date(featured.data.date)}</div><a href={`${base}articles/${featured.slug}`}><h2>{featured.data.title}</h2></a><p>{featured.data.description}</p><div class="story-byline">By {featured.data.author} · {minutes(featured.body)} min read</div><a class="text-link" href={`${base}articles/${featured.slug}`}>Read the story <span>↗</span></a></div>
    </section>}
    <section class="latest-section" aria-labelledby="latest-heading"><div class="section-heading"><h2 id="latest-heading">The field notes</h2><a href={`${base}articles`}>All articles ↗</a></div>
      <div class="notes-grid">{rest.map((article,index)=><article class="note"><a class={`note-art art-${index}`} href={`${base}articles/${article.slug}`} aria-label={article.data.title}>{article.slug.includes('markdown') ? <img src={`${base}images/articles/markdown-hero.png`} alt="Markdown editorial illustration" loading="lazy"/> : <><span class="art-label">THE TOOLS BEHIND THE TOOLS</span><span class="art-symbol">{article.slug.includes('oldest') ? '>_' : 'git commit'}</span><span class="art-bottom">{article.slug.includes('oldest') ? '01 / THE COMMAND LINE' : '02 / VERSION CONTROL'}<span>↗</span></span></>}</a><div class="eyebrow">{article.data.tags.filter(t=>t.toLowerCase()!=='ai'&&t!=='basics').join(' / ')} / Explained</div><h3><a href={`${base}articles/${article.slug}`}>{article.data.title}</a></h3><p>{article.data.description}</p><div class="story-byline">{date(article.data.date)} · {minutes(article.body)} min read</div></article>)}</div>
    </section>
    <section class="resource-section" aria-labelledby="resources-heading"><div class="resource-intro"><span class="eyebrow">KEEP THESE HANDY</span><h2 id="resources-heading">Less searching.<br />More doing.</h2><p>The commands and syntax you always look up, in one place.</p><a class="text-link" href={`${base}cheatsheets`}>All cheatsheets ↗</a></div><div class="resource-list">{resources.map(r=><a href={`${base}${r.path}`}><span class="resource-symbol">{r.symbol}</span><span><strong>{r.name}</strong><small>{r.detail}</small></span><span class="resource-arrow">↗</span></a>)}</div></section>
    <section class="subscribe-band"><div><span class="eyebrow">STAY CURIOUS</span><h2>Find your way through AI.</h2><p>More field notes, straight to your inbox.</p></div><a href="https://lostinai.substack.com/">Subscribe on Substack <span>↗</span></a></section>
  </div>
</BaseLayout>
