---
const base=import.meta.env.BASE_URL.replace(/\/?$/, '/');
const options=[{id:'magazine',name:'Illustrated magazine',description:'Bold typography, vivid illustration, and a strong editorial rhythm.',image:'01-illustrated-magazine.png'},{id:'notebook',name:'Field notebook',description:'Numbered entries, technical references, and a practical field-guide feel.',image:'02-field-notebook.png'},{id:'stories',name:'Visual story collection',description:'Big images, generous reading space, and quieter navigation.',image:'03-visual-story-collection.png'},{id:'cabinet',name:'Curiosity cabinet',description:'Collected clippings, dinosaur discoveries, and a research desk full of useful ideas.',image:'04-curiosity-cabinet.png'},{id:'pocket',name:'Pocket expedition guide',description:'A yellow handheld guide with collectible articles and big dinosaur energy.',image:'05-pocket-guide.png'},{id:'atlas',name:'Illustrated atlas',description:'Follow the map from the shipping port to the writing room. Every stop is a real story.',image:'06-illustrated-atlas.png'}];
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Six directions — Lost In AI Land</title></head><body><header><a href={base}>Lost In AI Land</a><span>DESIGN EXPLORATION</span></header><main><h1>One publication.<br/>Six ways to get lost.</h1><p class="intro">Open a working concept below. Each uses the same articles and links to the existing reading pages. The newest three explore a cabinet, a pocket guide, and an atlas.</p><p><a href={`${base}concept-art/lostinai-image-archive.zip`} download>Download all PNG artwork and design previews (ZIP) ↓</a></p><div class="options">{options.map((o,i)=><article><span class="number">0{i+1}</span><h2>{o.name}</h2><p>{o.description}</p><a class="open" href={`${base}concepts/${o.id}/`}>Open working preview →</a>{o.image && <a href={`${base}concept-art/${o.image}`} aria-label={`View full ${o.name} preview`}><img src={`${base}concept-art/${o.image}`} alt={`${o.name} design preview`} loading="lazy"/></a>}</article>)}</div></main><style is:global>*{box-sizing:border-box}body{font-family:Arial,sans-serif;margin:0;background:#f7f9fc;color:#101820}a{color:inherit;text-underline-offset:5px}header{padding:22px 5%;display:flex;justify-content:space-between;border-bottom:1px solid #cad2de;font-size:13px}header span{font-size:10px;letter-spacing:.1em}main{max-width:1450px;margin:auto;padding:45px 5%}h1{font-size:clamp(36px,5vw,65px);letter-spacing:-.055em;line-height:1.02;margin:0 0 20px}.intro{line-height:1.6;max-width:680px;color:#526172}.options{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px;margin-top:45px}.number{font-size:12px;color:#164bed}h2{font-size:24px;letter-spacing:-.04em;margin:12px 0}article p{font-size:14px;line-height:1.5;min-height:45px;color:#526172}.open{display:inline-block;padding:13px 16px;background:#101820;color:#fff;text-decoration:none;font-size:13px;margin:5px 0 24px}img{display:block;width:100%;border:1px solid #d9e0e9}a:focus-visible{outline:3px solid #164bed;outline-offset:5px}@media(max-width:700px){.options{grid-template-columns:1fr;gap:45px}.intro{font-size:14px}article p{min-height:0}}</style></body></html>
