---
import { getCollection } from 'astro:content';
export function getStaticPaths() {
  return ['magazine','notebook','stories'].map(direction=>({params:{direction}}));
}
const {direction} = Astro.params;
const variants = [{id:'magazine',name:'01 · Illustrated magazine'},{id:'notebook',name:'02 · Field notebook'},{id:'stories',name:'03 · Visual stories'},{id:'cabinet',name:'04 · Cabinet'},{id:'pocket',name:'05 · Pocket guide'},{id:'atlas',name:'06 · Atlas'}];
const base=import.meta.env.BASE_URL.replace(/\/?$/, '/');
const articles=(await getCollection('articles')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const [lead,...others]=articles;
const topic=(a:any)=>a.data.tags.find((t:string)=>!['basics','ai'].includes(t.toLowerCase())) ?? 'AI';
const href=(a:any)=>`${base}articles/${a.slug}/`;
const image=(a:any)=> {
  const key=topic(a).toLowerCase();
  const asset=key==='docker'?`docker-${direction}`:direction==='notebook'?`notebook-${key}`:key;
  return ['docker','cli','git','markdown'].includes(key)?`${base}images/variants/${asset}.png`:`${base}${(a.data.image??'/images/og-default.png').replace(/^\//,'')}`;
};
const listed=direction==='stories'?others.filter(a=>topic(a).toLowerCase()!=='markdown'):others;
const related=others.filter(a=>['markdown','git'].includes(topic(a).toLowerCase())).reverse();
const titles:Record<string,string>={Docker:'You and AI Have Been Shipping Together',CLI:'The Oldest Interface Is Having Its Biggest Moment',git:'The Button That Actually Saves Your Work',markdown:'You and AI Have Read Markdown Together'};
const decks:Record<string,string>={Docker:'The invisible infrastructure powering AI agents.',CLI:'The oldest interface in computing is finding a whole new audience.',git:'A little history. A big safety net for your work.',markdown:'The simple syntax that keeps humans and AI on the same page.'};
const title=(a:any)=>titles[topic(a)]??a.data.title;
const deck=(a:any)=>decks[topic(a)]??a.data.description;
const read=(a:any)=>`${Math.max(1,Math.ceil(a.body.split(/\s+/).length/220))} min read`;
const resources=[{name:'Docker',code:'docker run --rm hello-world',path:'docker-cheatsheet'},{name:'Git',code:'git status',path:'git-cheatsheet'},{name:'Markdown',code:'# Make yourself understood',path:'markdown-cheatsheet'}];
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex, nofollow"/><title>{variants.find(v=>v.id===direction)?.name} — Lost In AI Land</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link href="https://fonts.googleapis.com/css2?family=Anton&family=Caveat+Brush&family=Barlow+Condensed:wght@600;700;800&family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet"/></head>
<body class={direction}>
  <a class="skip" href="#content">Skip to content</a>
  <aside class="concept-bar" aria-label="Design preview switcher"><a href={`${base}concepts/`}>Compare designs</a><nav aria-label="Choose a concept">{variants.map(v=><a href={`${base}concepts/${v.id}/`} aria-current={direction===v.id?'page':undefined}>{v.name}</a>)}</nav><a href={base}>Current site →</a></aside>
  <div class="sheet">
    <header class="masthead">
      {direction==='notebook'&&<span class="series">THE BASICS SERIES</span>}
      <a class="brand" href={`${base}concepts/${direction}/`}>{direction==='notebook'?'Lost In AI Land':'LOST IN AI LAND'}</a>
      <nav class="main-nav" aria-label="Publication"><a href={`${base}articles/`}>Articles</a><a href={`${base}cheatsheets/`}>Cheatsheets</a><a href={`${base}tags/`}>Topics</a></nav>
      <p class="strap">{direction==='magazine'?'CLEARER IDEAS FOR AN AI-NATIVE WORLD.':'FIELD NOTES FOR THE AI AGE'}</p>
    </header>
    <main id="content">
      <section class="lead">
        {direction==='notebook'&&<div class="issue-number" aria-hidden="true">05</div>}
        <a class="hero-art" href={href(lead)} aria-label={`Read ${title(lead)}`}><img src={image(lead)} alt="A green dinosaur and holographic AI companion at a Docker container port" fetchpriority="high"/>{direction==='notebook'&&<div class="plate-caption">FIG. 05 — A portable home for your code and its dependencies.</div>}</a>
        <div class="lead-text-layout"><div class="lead-copy"><p class="eyebrow">{topic(lead)} / EXPLAINED</p><h1><a href={href(lead)}>{title(lead)}</a></h1><p class="deck">{deck(lead)}</p>{direction==='notebook'&&<p class="intro">Docker packages your application with the environment it needs to run. Here’s how containers became part of the machinery behind AI agents.</p>}<p class="byline">Josh Goldstein <span>·</span> {read(lead)}</p><a class="read-link" href={href(lead)}>Read article <span aria-hidden="true">→</span></a></div>{direction==='stories'&&<aside class="related-stories" aria-label="More stories">{related.map(a=><a href={href(a)}><div><p class="eyebrow">{topic(a)} / EXPLAINED</p><h2>{title(a)}</h2></div><img src={image(a)} alt={`${topic(a)} dinosaur illustration`} loading="lazy"/></a>)}</aside>}</div>
      </section>
      <section class="stories-section" aria-labelledby="stories-heading"><div class="section-heading"><h2 id="stories-heading">{direction==='notebook'?'More from the field notes':direction==='stories'?'Explore the stories':'The field notes'}</h2><a href={`${base}articles/`}>All articles →</a></div><div class="article-grid">{listed.map((a,index)=><article class="story"><a class="story-link" href={href(a)}>{direction==='notebook'&&<span class="entry-number">{String(4-index).padStart(2,'0')}</span>}<div class="story-art"><img src={image(a)} alt={`${topic(a)} article cover`} loading="lazy"/></div><div class="story-copy"><p class="eyebrow">{topic(a)} / EXPLAINED</p><h3>{title(a)}</h3><p class="summary">{deck(a)}</p><p class="byline">Josh Goldstein · {read(a)}</p><span class="read-link">Read article <span aria-hidden="true">→</span></span></div></a></article>)}</div></section>
      <section class="references" aria-labelledby="reference-heading"><div class="reference-heading"><p class="eyebrow">KEEP THESE HANDY</p><h2 id="reference-heading">{direction==='notebook'?'Essential commands for the AI era.':'A little less searching. A lot more doing.'}</h2><a class="plain-link" href={`${base}cheatsheets/`}>All cheatsheets →</a></div><div class="reference-grid">{resources.map(r=><a href={`${base}${r.path}/`}><h3>{r.name}<span aria-hidden="true">→</span></h3>{direction==='notebook'?<code>{r.code}</code>:<p>A practical quick reference.</p>}</a>)}</div></section>
    </main>
    <footer><div><strong>Lost In AI Land</strong><span>Stay curious. Make sense of what’s next.</span></div><a href={`${base}rss.xml`}>Follow via RSS →</a></footer>
  </div>
</body>
</html>
<style is:global>
*{box-sizing:border-box}body{margin:0;background:#fff;color:#101820;font-family:'DM Sans',sans-serif;-webkit-font-smoothing:antialiased}a{color:inherit;text-decoration:none}a:focus-visible{outline:3px solid #1450ed;outline-offset:5px}a:hover h1,a:hover h3,h1 a:hover,.main-nav a:hover{color:var(--accent)}.skip{position:absolute;top:-100px;background:#111;color:white;padding:12px;z-index:10}.skip:focus{top:5px}.concept-bar{background:#101820;color:#fff;display:flex;justify-content:space-between;align-items:center;gap:20px;padding:12px 24px;font-size:11px;position:sticky;top:0;z-index:5}.concept-bar nav{display:flex;gap:8px;flex-wrap:wrap}.concept-bar nav a{padding:8px 12px;border:1px solid #52606d;border-radius:3px}.concept-bar [aria-current]{background:#fff;color:#101820;border-color:#fff}.concept-bar>a:last-child{color:#b6c4d3}.sheet{max-width:1440px;margin:auto;padding:0 40px}.masthead{display:flex;align-items:end;justify-content:space-between;flex-wrap:wrap;padding:25px 0 14px;border-bottom:1px solid #111;gap:15px}.brand{font-size:clamp(35px,6.4vw,90px);letter-spacing:-.045em;line-height:.95;font-weight:700}.main-nav{display:flex;gap:25px;font-size:14px;margin-bottom:5px}.strap{font:10px 'IBM Plex Mono',monospace;letter-spacing:.15em;margin:0;width:100%}.lead{display:grid;grid-template-columns:1fr 1.55fr;gap:35px;padding:30px 0 35px;align-items:center}.hero-art{grid-column:2;grid-row:1;min-width:0}.hero-art img{display:block;width:100%;height:auto}.lead-copy{grid-row:1;grid-column:1}.eyebrow{font:500 11px 'IBM Plex Mono',monospace;letter-spacing:.06em;text-transform:uppercase;color:var(--accent);margin:0 0 14px}h1,h2,h3,p{margin-top:0}h1{font-size:clamp(36px,5vw,70px);line-height:1.02;letter-spacing:-.035em;margin-bottom:20px;text-wrap:balance}.deck{font-size:clamp(18px,2vw,27px);line-height:1.3;color:#535d68;letter-spacing:-.025em;margin-bottom:20px}.byline{font-size:11px;color:#536171;line-height:1.5}.byline span{margin:0 10px}.read-link{display:inline-flex;gap:20px;align-items:center;font-size:14px;color:var(--accent);font-weight:600;line-height:1.5}.section-heading{border-top:1px solid #192330;display:flex;justify-content:space-between;align-items:baseline;gap:20px;padding:22px 0}.section-heading h2{font-size:32px;letter-spacing:-.035em;margin:0}.section-heading>a,.plain-link{font-size:12px;color:var(--accent)}.article-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:25px}.story-link{display:block}.story-art{aspect-ratio:1.7;background:#edf2f9;overflow:hidden}.story-art img{width:100%;height:100%;object-fit:cover;display:block}.story-copy{padding:16px 0}.story h3{font-size:25px;line-height:1.12;letter-spacing:-.025em;margin-bottom:12px;text-wrap:balance}.story .eyebrow{font-size:10px}.summary{font-size:14px;color:#535d68;line-height:1.5;margin-bottom:16px}.story .read-link{font-size:12px}.references{display:grid;grid-template-columns:1fr 1.5fr;gap:40px;background:#edf5ff;padding:30px;margin:30px 0}.reference-heading h2{font-size:27px;line-height:1.1;letter-spacing:-.02em}.reference-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;align-items:center}.reference-grid>a{border-left:1px solid #b6c9df;padding-left:18px}.reference-grid h3{display:flex;justify-content:space-between;font-size:17px;gap:10px}.reference-grid p{font-size:12px;line-height:1.5;color:#536171;margin:0}footer{display:flex;justify-content:space-between;align-items:center;border-top:1px solid #192330;padding:20px 0 30px;font-size:11px;gap:20px}footer div{display:flex;gap:20px}footer span{color:#536171}.magazine{--accent:#064cff}.magazine .brand,.magazine h1,.magazine h2,.magazine h3{font-family:'Barlow Condensed',sans-serif;font-weight:800}.magazine .brand{font-size:clamp(42px,7vw,100px)}.magazine h1{font-size:clamp(42px,6vw,84px);line-height:.97}.magazine .hero-art img{aspect-ratio:1.25;object-fit:cover;object-position:52% 15%}.magazine .read-link{background:var(--accent);color:white;padding:12px 20px;border-radius:24px}.magazine .story .read-link{background:none;color:var(--accent);padding:0}.magazine .references h2{font-size:34px}.notebook{--accent:#d74414;color:#13223b;background:#fcfdff}.notebook .masthead{position:relative;display:flex;flex-direction:column;align-items:center;padding-top:28px;gap:12px;border-color:#9eb5cf}.notebook .brand{font:400 clamp(38px,5vw,70px)/1 'DM Serif Display',Georgia,serif;letter-spacing:-.035em}.notebook .strap{text-align:center;order:1}.notebook .main-nav{order:2;border-top:1px solid #aec5df;width:100%;justify-content:center;padding-top:14px;margin-top:4px;font-family:Georgia,serif;font-size:17px}.series{position:absolute;left:0;top:35px;font:10px 'IBM Plex Mono',monospace;color:#426a96;letter-spacing:.1em}.notebook .lead{grid-template-columns:1fr 1.4fr;position:relative;padding-top:45px}.notebook .issue-number{position:absolute;top:32px;font:600 37px 'Barlow Condensed',sans-serif;color:var(--accent)}.notebook .lead-copy{padding-top:40px}.notebook h1,.notebook h2,.notebook h3{font-family:'DM Serif Display',Georgia,serif;font-weight:400}.notebook h1{font-size:clamp(36px,4.5vw,62px)}.notebook .deck{font-family:Georgia,serif;font-size:23px}.intro{font:16px/1.6 Georgia,serif;max-width:400px}.plate-caption{font:10px/1.6 'IBM Plex Mono',monospace;color:#426a96;border-bottom:1px solid #aec5df;padding:12px 0}.notebook .read-link{text-decoration:underline;text-underline-offset:6px}.notebook .article-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.notebook .story{border-bottom:1px solid #aec5df;position:relative}.notebook .story-link{display:grid;grid-template-columns:1.1fr 1fr;gap:20px;padding:0 0 24px 40px}.notebook .story-art{grid-column:2;grid-row:1;align-self:center;aspect-ratio:1.15}.notebook .story-copy{grid-column:1;grid-row:1}.entry-number{position:absolute;left:0;top:10px;font:600 30px 'Barlow Condensed',sans-serif;color:var(--accent)}.notebook .story:last-child{grid-column:1/-1}.notebook .story:last-child .story-link{grid-template-columns:2fr 1fr}.notebook .story:last-child .story-art{aspect-ratio:3}.notebook .references{background:repeating-linear-gradient(0deg,#f0f6fc,#f0f6fc 24px,#e6effa 25px);border-top:1px solid #aec5df}.notebook code{display:block;font:11px/1.6 'IBM Plex Mono',monospace;padding:12px;background:white;border:1px solid #c5d7eb;overflow-wrap:anywhere}.stories{--accent:#1748c6}.stories .sheet{max-width:1550px}.stories .masthead{flex-direction:column;align-items:center;border:0;padding:28px 0 22px;gap:20px}.stories .brand{font:400 40px/1 'DM Serif Display',Georgia,serif}.stories .strap{display:none}.stories .main-nav{font-family:Georgia,serif;font-size:16px}.stories .lead{display:flex;flex-direction:column;align-items:stretch;padding:0 0 30px;gap:30px}.stories .hero-art{margin:0 -40px}.stories .hero-art img{aspect-ratio:2.35;object-fit:cover;object-position:50% 22%}.stories .lead-copy{max-width:950px;padding:0 25px}.stories h1,.stories h2,.stories h3{font-family:'DM Serif Display',Georgia,serif;font-weight:400}.stories h1{font-size:clamp(35px,5.2vw,72px);max-width:1000px;line-height:1.03}.stories .deck{font:25px/1.4 Georgia,serif}.stories .read-link{text-decoration:underline;text-underline-offset:5px}.stories .article-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.stories .story:first-child{grid-column:1/-1;max-width:none;border-bottom:1px solid #d4dbe4;padding-bottom:15px}.stories .story:first-child .story-link{display:grid;grid-template-columns:1.2fr 1fr;gap:35px;align-items:center}.stories .story h3{font-size:28px}.stories .references{background:white;border-top:1px solid #101820;padding:30px 0}.stories .reference-heading h2{font-size:28px}
@media(max-width:1000px){.series{position:static}.notebook .series{order:-1}.brand{font-size:58px}.main-nav{gap:18px}.lead{gap:25px}.magazine h1{font-size:55px}.concept-bar{font-size:10px;gap:10px}.concept-bar nav a{padding:8px}.reference-grid{gap:10px}.references{gap:25px}.notebook .story-link{grid-template-columns:1fr;padding-left:35px}.notebook .story-art{grid-row:1;grid-column:1;aspect-ratio:1.8}.notebook .story-copy{grid-row:2;grid-column:1}.notebook .story:last-child .story-link{grid-template-columns:1fr}.notebook .story:last-child .story-art{aspect-ratio:3}}
@media(max-width:650px){.sheet{padding:0 20px}.concept-bar{display:block;padding:8px 10px}.concept-bar>a{display:none}.concept-bar nav{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));justify-content:center;gap:5px}.concept-bar nav a{font-size:10px;padding:9px 6px;white-space:nowrap}.masthead{padding:24px 0 14px}.magazine .brand{font-size:clamp(33px,9.1vw,55px)}.main-nav{font-size:13px;gap:25px;margin:5px 0}.strap{font-size:8px;letter-spacing:.07em}.lead{display:flex;flex-direction:column;gap:20px;padding:24px 0}.hero-art{width:100%;order:0}.lead-copy{order:1;width:100%}.magazine .hero-art img{aspect-ratio:1.5}.magazine h1{font-size:49px}.deck{font-size:22px}.eyebrow{font-size:10px}.article-grid{grid-template-columns:1fr;gap:15px}.story h3{font-size:30px}.section-heading h2{font-size:29px}.section-heading>a{font-size:11px;white-space:nowrap}.references{grid-template-columns:1fr;padding:22px;margin:20px 0;gap:20px}.reference-grid{grid-template-columns:1fr}.reference-grid>a{padding:14px 0;border:0;border-top:1px solid #b6c9df}.reference-grid h3{margin-bottom:8px}.notebook .brand{font-size:37px}.notebook .masthead{gap:14px}.notebook .strap{font-size:9px}.notebook .lead{padding-top:20px}.notebook .issue-number{position:static;align-self:start;font-size:33px;order:0}.notebook .hero-art{order:1}.notebook .lead-copy{order:2;padding:0}.notebook h1{font-size:40px}.notebook .deck{font-size:23px}.notebook .article-grid{grid-template-columns:1fr}.notebook .story-link{display:block}.notebook .story-art{aspect-ratio:1.8}.notebook .story:last-child .story-art{aspect-ratio:1.8}.stories .brand{font-size:35px}.stories .hero-art{margin:0 -20px;width:calc(100% + 40px)}.stories .hero-art img{aspect-ratio:1.5;object-position:50% 20%}.stories .lead-copy{padding:0}.stories h1{font-size:42px}.stories .deck{font-size:22px}.stories .article-grid{grid-template-columns:1fr}.stories .story:first-child .story-link{display:block}.stories .story h3{font-size:29px}footer{align-items:start}footer div{flex-direction:column;gap:8px;max-width:230px}footer>a{white-space:nowrap}}

/* Approved mockup alignment: real standalone art, readable HTML, distinct compositions. */
.lead-text-layout{grid-row:1;grid-column:1;min-width:0}
.magazine .brand,.magazine h1,.magazine h2,.magazine h3{font-family:'Anton','Barlow Condensed',sans-serif;font-weight:400}
.magazine .brand{font-size:clamp(48px,6.5vw,94px);letter-spacing:-.035em}
.magazine .lead{grid-template-columns:1fr 1.9fr;gap:30px;align-items:start}
.magazine h1{font-size:clamp(46px,5.4vw,78px);line-height:1.04;letter-spacing:-.025em}
.magazine .hero-art img{aspect-ratio:4/3;object-fit:contain}
.magazine .lead-copy{padding-top:20px}
.magazine .deck{font-size:clamp(19px,2.2vw,29px)}
.magazine .story h3{font-size:29px;line-height:1.15}
.magazine .references{border-radius:14px}
.notebook{background:#fff}
.notebook .brand{font-weight:400;letter-spacing:-.045em}
.notebook .lead{grid-template-columns:1fr 1.4fr;gap:10px;align-items:center;padding-top:30px}
.notebook .issue-number{top:35px;font-size:52px;line-height:1}
.notebook .lead-copy{padding:5px 0 0 75px}
.notebook h1{font-size:clamp(36px,4.5vw,64px);line-height:1.02}
.notebook .hero-art img{aspect-ratio:4/3;object-fit:contain}
.notebook .plate-caption{font-size:9px}
.notebook .story-art{background:transparent;aspect-ratio:4/3}
.notebook .story-art img{object-fit:contain}
.notebook .story-link{padding-left:65px}
.notebook .entry-number{font-size:43px;top:16px}
.notebook .summary{font-family:Georgia,serif;color:#293d57}
.notebook .story:last-child .story-link{grid-template-columns:1.6fr 1fr;align-items:center}
.notebook .story:last-child .story-art{aspect-ratio:16/9}
.notebook .references{background:#f0f6fc;border-radius:14px}
.notebook .reference-grid>a{min-width:0}
.stories .brand{font:400 43px/1 'Caveat Brush',cursive;letter-spacing:-.025em;transform:rotate(-2deg)}
.stories .masthead{padding:22px 0 18px;gap:18px}
.stories .hero-art img{aspect-ratio:2/1;object-fit:cover;object-position:center}
.stories .lead-text-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(240px,.52fr);gap:30px;padding:0 15px}
.stories .lead-copy{padding:0;max-width:none}
.stories h1{font-size:clamp(36px,4.6vw,66px);line-height:1.03}
.stories .deck{font-size:26px}
.related-stories{border-left:1px solid #d4dbe4;padding-left:25px;display:flex;flex-direction:column;justify-content:center}
.related-stories>a{display:grid;grid-template-columns:1.2fr 1fr;gap:15px;padding:15px 0;align-items:center}
.related-stories>a+a{border-top:1px solid #d4dbe4}
.related-stories .eyebrow{font-size:9px;margin-bottom:10px}
.related-stories h2{font-size:22px;line-height:1.12;letter-spacing:-.025em;margin:0}
.related-stories img{width:100%;aspect-ratio:1.25;object-fit:cover;border-radius:3px}
.stories .story:first-child{grid-column:auto;border:0;padding:0}
.stories .story:first-child .story-link{display:block}
.stories .story-art{aspect-ratio:2.2;border-radius:4px}
.stories .story h3{font-size:28px}
@media(max-width:1000px){
.magazine .lead{grid-template-columns:1fr 1.5fr}.magazine h1{font-size:55px}.magazine .brand{font-size:65px}
.notebook .lead-copy{padding-left:55px}.notebook .issue-number{font-size:40px}.notebook .story-link{padding-left:45px}.notebook .entry-number{font-size:34px}
.stories .lead-text-layout{grid-template-columns:1fr}.related-stories{border:0;border-top:1px solid #d4dbe4;padding:15px 0 0;display:grid;grid-template-columns:1fr 1fr;gap:25px}.related-stories>a+a{border:0}.related-stories h2{font-size:23px}
}
@media(max-width:650px){
.magazine .brand{font-size:clamp(34px,9vw,56px)}.magazine .lead{display:flex;gap:20px}.magazine .lead-copy{padding:0}.magazine h1{font-size:49px}.magazine .hero-art img{aspect-ratio:4/3}.magazine .story h3{font-size:29px}
.lead-text-layout{width:100%;order:2}.notebook .lead-copy{padding:0}.notebook .hero-art{order:1}.notebook .issue-number{font-size:35px}.notebook .story-link{padding-left:42px}.notebook .entry-number{font-size:33px}.notebook .story-art,.notebook .story:last-child .story-art{aspect-ratio:16/9}.notebook h1{font-size:40px}
.stories .brand{font-size:37px}.stories .hero-art img{aspect-ratio:1.55;object-position:51% center}.stories .lead-text-layout{padding:0;gap:25px}.stories h1{font-size:42px}.stories .deck{font-size:22px}.related-stories{display:block}.related-stories>a+a{border-top:1px solid #d4dbe4}.related-stories>a{grid-template-columns:1.6fr 1fr}.related-stories h2{font-size:23px}
}

</style>
